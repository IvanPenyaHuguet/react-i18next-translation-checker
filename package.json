{
  "author": "Raman Lauryniuk <romanrostislavovich@gmail.com>",
  "name": "react-i18next-translation-checker",
  "version": "2.1.0",
  "description": "Simple tools for check `react-i18next` keys in app",
  "license": "MIT",
  "repository": "IvanPenyaHuguet/react-i18next-translation-checker",
  "bugs": "https://github.com/IvanPenyaHuguet/react-i18next-translation-checker/issues",
  "bin": {
    "react-i18next-translation-checker": "dist/bin.js"
  },
  "types": "dist/src/core/index.d.ts",
  "main": "dist/src/core/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "tslint": "./node_modules/.bin/tslint",
    "build": "tsc -p .",
    "lint": "npm run lint:typescript && npm run lint:markdown",
    "lint:typescript": "tslint -c tslint.json --project . -t codeFrame",
    "lint:markdown": "markdownlint --config ./config/markdownlint.json ./docs/**/*.md",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "ts-node --project tsconfig.test.json ./node_modules/mocha/bin/mocha ./test/unit/*.test.ts",
    "test:integration": "ts-node --project tsconfig.test.json ./node_modules/mocha/bin/mocha ./test/integration/*.test.ts",
    "test:url": "npm run build && node dist/bin.js -p ./test/integration/inputs/views/*.html -l https://raw.githubusercontent.com/romanrostislavovich/react-i18next-lint/refs/heads/master/test/integration/inputs/locales/EN-eu.json",
    "pre:release": "npm run lint && npm run build",
    "semantic-release": "",
    "self-lint": "npx react-i18next-translation-checker -p ./test/integration/inputs/views/*.{html,ts,js} -l ./test/integration/inputs/locales/*.json -i ./test/integration/inputs/locales/incorrect.json"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "keywords": [
    "react-i18next",
    "i18next",
    "validator",
    "linting",
    "cli",
    "react",
    "validator",
    "linter",
    "lint",
    "checker",
    "translate"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "latest",
    "access": "public"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5",
    "uuid": "^13.0.0"
  },
  "nyc": {
    "check-coverage": true,
    "lines": 70,
    "statements": 70,
    "functions": 70,
    "branches": 70,
    "extension": [
      ".ts",
      ".tsx"
    ],
    "exclude": [
      "coverage/**/*",
      "test/**/*",
      "dist/**/*",
      "src/config.ts",
      "index.ts",
      "bin.ts"
    ],
    "reporter": [
      "html",
      "text-summary"
    ],
    "all": true,
    "require": [
      "ts-node/register"
    ]
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "conventional-cli": "^1.2.0",
    "dir-glob": "^3.0.1",
    "glob": "^13.0.6",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/dir-glob": "^2.0.3",
    "@types/lodash": "^4.17.24",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "chai": "^6.2.2",
    "markdownlint-cli": "^0.48.0",
    "mocha": "^11.7.6",
    "nyc": "^18.0.0",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
